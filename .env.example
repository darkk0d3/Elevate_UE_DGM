# Copy this file to .env.local for local testing, and set the same three
# values as Environment Variables in your hosting provider's dashboard
# (Vercel: Project Settings > Environment Variables).

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=

# Supabase Dashboard > Project Settings > API > service_role key (secret!)
# Never put this in the frontend or a public repo value — only as a server env var.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string, used to sign login session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
